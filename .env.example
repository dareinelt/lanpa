# Beispielkonfiguration – Kopie als ".env" anlegen und Werte ersetzen.
# Diese Datei enthaelt KEINE echten Zugangsdaten.

# --- Anwendung ---------------------------------------------------------------
APP_NAME=Intranet
APP_ENV=production
APP_DEBUG=false
# Oeffentliche Adresse der Landingpage (Produktivwert eintragen)
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Berlin
APP_SESSION_NAME=INTRANETSESSID
# Auf true setzen, sobald die Seite ausschliesslich ueber HTTPS erreichbar ist.
APP_FORCE_SECURE_COOKIES=false
APP_SESSION_IDLE_TIMEOUT=3600
APP_LOG_LEVEL=info
APP_MAX_LOGO_BYTES=524288
APP_ALLOW_SVG_LOGO=true
APP_MAX_BACKGROUND_BYTES=2097152

# Veroeffentlichter Port des Webcontainers
APP_PORT=8080
# Veroeffentlichter HTTPS-Port (Zertifikat im Adminbereich -> Zertifikate).
# Ohne gueltiges Zertifikat gilt ein selbstsigniertes Notfall-Zertifikat und
# HTTP bleibt fuer die dort hinterlegten Quellnetze (Standard
# 192.168.200.0/21) erlaubt, alle anderen werden auf HTTPS umgeleitet.
APP_HTTPS_PORT=8443
# false = kein HTTPS im auth-Container (z. B. hinter externem TLS-Proxy)
TLS_ENABLED=true
# Port des optionalen phpMyAdmin (Profil "tools")
PMA_PORT=8081
# Beim Start Beispielnavigation anlegen (nach der Ersteinrichtung auf false setzen)
SEED_ON_START=true

# --- Datenbank ---------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=intranet
DB_USER=intranet
# PFLICHT: eigenes, starkes Passwort eintragen
DB_PASSWORD=bitte-aendern
DB_ROOT_PASSWORD=bitte-aendern-root
# MySQL-Image (9.7 LTS). Nur Patch-Versionen der Reihe 9.7 eintragen.
# DB_IMAGE_TAG=9.7.2
# Pufferpool der Datenbank (InnoDB). Muss in die RAM-Reserve des Hosts passen
# und das Arbeits-Set der Anwendung abdecken; siehe docs/installation.md,
# Abschnitt "Dimensionierung".
# DB_BUFFER_POOL=1G

# --- Erstes Administrationskonto --------------------------------------------
# Wird nur beim ersten Start angelegt. Ohne ADMIN_PASSWORD wird ein
# Zufallspasswort erzeugt und einmalig im Containerlog ausgegeben.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Active Directory / LDAP -------------------------------------------------
# Startwerte der Hauptquelle; alle Werte sind im Adminbereich pflegbar
# (Verwaltung -> Active Directory), dort auch weitere Identitaetsquellen
# (Zweigstellen, Tochtergesellschaften). Das Passwort des Dienstkontos wird
# NUR im Adminbereich eingegeben und verschluesselt in der Datenbank
# gespeichert (Schluessel in storage/keys/) - kein Eintrag in dieser Datei.
LDAP_HOST=dc01.example.internal
LDAP_PORT=636
LDAP_USE_TLS=true
LDAP_VERIFY_CERT=true
LDAP_BASE_DN=OU=Benutzer,DC=example,DC=internal
LDAP_BIND_DN=CN=svc-intranet,OU=Dienstkonten,DC=example,DC=internal
LDAP_FILTER=(&(objectClass=user)(objectCategory=person))
LDAP_TIMEOUT=10
LDAP_PAGE_SIZE=500
LDAP_SYNC_INTERVAL=3600

# AD-Gruppen fuer die Rechtevergabe (Kacheln, Office). Pfad(e), unter denen die
# relevanten Gruppen liegen; mehrere Pfade mit ";" trennen. Leer = keine
# Gruppensynchronisation. Verschachtelte Mitgliedschaften werden aufgeloest.
# Die Vorschlaege im Adminbereich stammen ausschliesslich aus diesem Datenbestand.
LDAP_GROUP_BASE_DN=
LDAP_GROUP_FILTER=(objectClass=group)
LDAP_GROUP_NAME_ATTRIBUTE=cn

# Attributzuordnung (Standardwerte des Active Directory)
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_FIRST_NAME=givenName
LDAP_ATTR_LAST_NAME=sn
LDAP_ATTR_PHONE=telephoneNumber
LDAP_ATTR_MOBILE=mobile
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DEPARTMENT=department
LDAP_ATTR_TITLE=title
LDAP_ATTR_MODIFIED=whenChanged
LDAP_ATTR_UNIQUE_ID=objectGUID
# Windows-Benutzername fuer die automatische NTLM-Authentifizierung
LDAP_ATTR_SAMACCOUNT_NAME=sAMAccountName

# --- Automatische Windows-Authentifizierung (Kerberos/NTLM) -------------------
# Aktiviert die Uebernahme des Windows-Benutzers aus dem auth-Container.
SSO_ENABLED=false
# Keine Anmeldepflicht: Oeffentliche Elemente sind immer sichtbar; die
# Anmeldung wird nur am Anmeldepunkt /sso/anmelden verlangt. Automatischer Versuch einmal je
# Sitzung (Domaenen-PCs werden unbemerkt erkannt; Browser ausserhalb der
# Domaene zeigen evtl. einmal einen Anmeldedialog - "Abbrechen" fuehrt ohne
# Anmeldung weiter). false = nur ueber den Link "Mit Windows anmelden".
SSO_AUTO_LOGIN=true
# Gueltigkeit der erkannten Anmeldung in der Sitzung (Sekunden, 0 = Sitzungsende).
SSO_SESSION_LIFETIME=28800
# Header, den der auth-Container befuellt (i. d. R. unveraendert lassen).
SSO_HEADER=X-Remote-User
# Optionaler Header mit kommagetrennten AD-Gruppen. Die Gruppen fuer die
# Rechtevergabe stammen in erster Linie aus der AD-Synchronisation
# (LDAP_GROUP_BASE_DN); Header-Gruppen werden zusaetzlich beruecksichtigt.
SSO_GROUPS_HEADER=X-Remote-Groups
# Kommagetrennte Liste vertrauenswuerdiger Proxys (Hostname/IP des auth-Containers).
SSO_TRUSTED_PROXY=auth
# Computername des auth-Containers im AD (NetBIOS: A-Z, 0-9, -, max. 15
# Zeichen). Je Installation in derselben Domaene eindeutig waehlen.
SSO_NETBIOS_NAME=lanpa-sso
# Kerberos: Der auth-Container registriert den Service Principal
# HTTP/<Hostname aus APP_URL> am Computerkonto und erzeugt die Keytab selbst.
# Realm (z. B. FIRMA.LOCAL) nur setzen, wenn die automatische Ermittlung am
# Domaenencontroller fehlschlaegt. Weitere Hostnamen, unter denen das Intranet
# aufgerufen wird (kommagetrennt), erhalten ebenfalls einen SPN.
# Die Clients muessen das Intranet unter genau diesem DNS-Namen aufrufen;
# Uhren von Clients, DC und auth-Container duerfen hoechstens 5 Minuten
# abweichen. Der auth-Container gleicht seine Uhr beim Start und laufend mit
# den Zeitservern aus dem Adminbereich (sonst den Domaenencontrollern) ab.
# Ohne Anmeldedialog: Die Clients muessen den Hostnamen als "Lokales Intranet"
# bzw. per AuthServerAllowlist freigeben (README "Anmeldedialog vermeiden",
# scripts/sso-client-setup.ps1). Ein Alias ohne Punkt (z. B. "intranet") gilt
# in Windows automatisch als Intranet.
SSO_REALM=
SSO_SPN_HOSTS=
# Domaene, Domaenencontroller, Zeitserver und Konto fuer den Domaenenbeitritt werden im
# Adminbereich gepflegt (verschluesselt gespeichert); die auth-Container rufen
# sie beim Start von der Anwendung ab. Weitere Domaenen ohne
# Vertrauensstellung: dort aktivieren und ./scripts/sso-domains.sh ausfuehren.
# Testmodus: simuliert eine bestehende Windows-Anmeldung auf der Startseite
# (ohne Domaene). Nur wirksam, wenn APP_ENV nicht "production" ist.
# Der Benutzer wird im Telefonbuch gesucht (SamAccountName); fehlt er, gelten
# Anzeigename, E-Mail und Gruppen (kommagetrennt) aus den folgenden Werten.
SSO_FAKE_USER=
SSO_FAKE_DISPLAY_NAME=
SSO_FAKE_EMAIL=
SSO_FAKE_GROUPS=

# --- Office: Nextcloud + Euro-Office (optional) -------------------------------
# Einrichtung per Einzeiler: ./scripts/office-setup.sh [--with-ad] [--with-sso]
# Das Skript setzt die folgenden Werte selbst und erzeugt alle Secrets unter
# OFFICE_SECRETS_DIR (Standard ./secrets, niemals versionieren).
OFFICE_ENABLED=false
# COMPOSE_PROFILES=office
# OFFICE_SECRETS_DIR=./secrets
# Oeffentliche Pfade hinter dem auth-Container (Standardwerte beibehalten).
# OFFICE_PUBLIC_PATH=/office/
# EUROOFFICE_PUBLIC_PATH=/eurooffice/
# Versionen aus den offiziellen Quellen; Aktualisierung: ./scripts/office-update.sh
EUROOFFICE_IMAGE_TAG=v9.3.4-hotfix.1
# KI-Plugin der Editoren (Lokale KI, Adminbereich) anbieten.
EUROOFFICE_AI_PLUGIN=true
NEXTCLOUD_IMAGE_TAG=34.0.4-apache
# NEXTCLOUD_DB_IMAGE_TAG=17.6-alpine
# NEXTCLOUD_REDIS_IMAGE_TAG=7.4.5-alpine
# Katalog des Storage-Sync (eigener MySQL-Container storage-sync-catalog,
# Zugangsdaten = DB_USER/DB_PASSWORD/DB_ROOT_PASSWORD) und Redis-Helfer
# storage-sync-redis (Passwort = DB_PASSWORD). Siehe docs/storage.md.
# STORAGE_CATALOG_DB_NAME=storage_sync
# InnoDB-Pufferpool; Faustregel ~1 GB je 2 Mio. katalogisierte Dateien.
# STORAGE_CATALOG_BUFFER_POOL=512M
# STORAGE_SYNC_REDIS_IMAGE_TAG=7.4.5-alpine
NEXTCLOUD_ADMIN_USER=ncadmin
# Weitere Hostnamen, unter denen das Intranet erreichbar ist (Leerzeichen-getrennt).
# Hostnamen aus APP_URL, SSO_SPN_HOSTS, dem Domaenenbeitritt und dem HTTPS-
# Zertifikat uebertraegt das Intranet automatisch an Nextcloud (trusted_domains).
NEXTCLOUD_EXTRA_TRUSTED_DOMAINS=
NEXTCLOUD_UPLOAD_LIMIT=4G
NEXTCLOUD_PHP_MEMORY_LIMIT=1024M
# AD-Anbindung von Nextcloud (nutzt LDAP_* und LDAP_GROUP_BASE_DN von oben).
# Wird automatisch aktiviert, sobald das Intranet der Domaene beigetreten ist
# (SSO_ENABLED=true) - auch bei bereits eingerichtetem Office.
NEXTCLOUD_LDAP_ENABLED=false
# Nur Mitglieder dieser AD-Gruppen (DNs, ";"-getrennt) duerfen sich anmelden.
NEXTCLOUD_LDAP_ALLOWED_GROUPS=
# AD-Gruppe (cn), deren Mitglieder Nextcloud-Administratoren werden.
NEXTCLOUD_LDAP_ADMIN_GROUP=
# Office-Bearbeitung auf diese Gruppen (cn, kommagetrennt) beschraenken; leer = alle.
NEXTCLOUD_OFFICE_GROUPS=
# Abweichender Gruppen-Pfad/-Filter nur fuer Nextcloud (sonst LDAP_GROUP_BASE_DN).
NEXTCLOUD_LDAP_GROUPS_BASE_DN=
NEXTCLOUD_LDAP_USER_FILTER=
NEXTCLOUD_LDAP_GROUP_FILTER=
# Automatische Anmeldung in Nextcloud mit dem im Intranet erkannten Benutzer
# (Anmeldeseite -> Intranet -> signiertes Einmal-Token). "false" zeigt das
# normale Anmeldeformular.
NEXTCLOUD_SSO_LOGIN_REDIRECT=true
# Unbekannte Benutzer in Nextcloud lokal anlegen (ohne AD bzw. zum Testen).
NEXTCLOUD_SSO_AUTOPROVISION=false
# Lokale KI: Adresse, Modell und Aktivierung werden im Intranet unter
# Admin > Office > Lokale KI gepflegt und an Nextcloud und Euro-Office
# weitergereicht. Apps integration_openai und assistant installieren:
NEXTCLOUD_AI_APPS=true
# Optionaler API-Schluessel des KI-Endpunkts als Secret (hat Vorrang vor dem
# im Adminbereich hinterlegten Schluessel), alternativ OFFICE_AI_API_KEY_FILE.
# OFFICE_AI_API_KEY=
# KI-Textunterstuetzung in Orvanta (nutzt den Endpunkt unter Office -> Lokale KI).
# Zeitlimit je Anfrage in Sekunden; lokaler Testdienst: docker compose --profile ki up -d
# (Port KI_PORT, Modell KI_MODEL_REPO/KI_MODEL_FILE). Mit OFFICE_AI_SEED_URL traegt
# scripts/seed.php den Endpunkt einmalig ein, z. B. http://ki:8080/v1
ORVANTA_AI_TIMEOUT=30
# KI_PORT=8089
# OFFICE_AI_SEED_URL=http://ki:8080/v1
# OFFICE_AI_SEED_MODEL=qwen2.5-0.5b-instruct
# Groesseres Modell (ca. 5,7 GB, braucht >= 8 GB RAM fuer Docker; Alias = OFFICE_AI_SEED_MODEL):
# KI_MODEL_REPO=unsloth/Qwen3.5-9B-GGUF
# KI_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf
# KI_MODEL_ALIAS=qwen3.5-9b
# KI_THREADS=8
# KI_REASONING=off
# Sicherung (Container office-backup): Ziel, Aufbewahrung (Anzahl), taegliche Stunde (leer = keine automatische Sicherung).
OFFICE_BACKUP_DIR=./backups
OFFICE_BACKUP_RETENTION=7
OFFICE_BACKUP_SCHEDULE_HOUR=2
# Internes Netz der Office-Dienste (nur bei Kollisionen aendern).
# OFFICE_SUBNET=172.30.250.0/24

# --- Orvanta: SMTP-/IMAP-Proxy (Container mail-proxy) -----------------------
# Fuer Benutzer ohne Exchange-Postfach (Admin -> Office -> SMTP-/IMAP-Proxy,
# docs/mail-proxy.md). Server, Postfaecher und Zuordnungen stehen verschluesselt
# in der Datenbank – hier keine Zugangsdaten eintragen.
# Interne Adresse des Proxys (nur internes Docker-Netz mail_proxy).
# MAIL_PROXY_URL=http://mail-proxy:8025
# Gueltigkeit des Zuordnungs-Caches in Sekunden (0 = aus, max. 3600).
# MAIL_PROXY_CACHE_TTL=300
# Gleichzeitige Anfragen, gepoolte IMAP-Verbindungen und deren Leerlaufzeit.
# MAIL_PROXY_MAX_CONNECTIONS=32
# MAIL_PROXY_POOL_SIZE=32
# MAIL_PROXY_POOL_IDLE_SECONDS=90
# Maximale Groesse einer gesendeten/geladenen Nachricht in MB.
# MAIL_PROXY_MAX_MESSAGE_MB=35
# Zusaetzlich gesperrte Zielnetze (kommagetrennt, z. B. 10.0.5.0/24), z. B.
# Netze interner Dienste, die nie als Mailserver eingetragen werden duerfen.
# MAIL_PROXY_DENY_CIDRS=

# --- Kennzahlen des auth-Containers (Admin-Dashboard) ------------------------
# Die Hauptinstanz misst die CPU- und die Arbeitsspeicher-Auslastung, die im
# Messfenster aufgebauten Client-Verbindungen und die Anfragen je Quellnetz im
# Container und meldet sie an
# POST /internal/auth-metrics; daraus entsteht die Kachel "Reverse-Proxy" auf
# dem Admin-Dashboard (docker/auth/metrics.py).
# Abstand der Proben in Sekunden (Standard 60).
# AUTH_METRICS_INTERVAL=60

# --- Ressourcen des auth-Containers ------------------------------------------
# Zugewiesen = Obergrenze, Reserviert = Reservierung. 0 = keine Grenze bzw.
# keine Reservierung (es gilt der Standard von Docker). Eine echte
# CPU-Reservierung gibt es ausserhalb von Docker Swarm nicht; AUTH_CPU_SHARES
# gewichtet die CPU nur relativ zu den anderen Containern (Docker-Standard
# 1024). AUTH_MEMORY_LIMIT ist zugleich die Bezugsgroesse der Anzeige des
# Arbeitsspeichers auf der Kachel "Reverse-Proxy" (ohne Grenze gilt der
# Arbeitsspeicher des Hosts, wie bei "docker stats"). Aenderungen wirken erst nach "docker compose up -d auth": der
# Container wird dabei neu angelegt, ein "docker compose restart auth"
# uebernimmt sie nicht. Siehe docs/installation.md, Abschnitt "Dimensionierung".
# AUTH_CPUS=2
# AUTH_MEMORY_LIMIT=2G
# AUTH_MEMORY_RESERVED=512M
# AUTH_CPU_SHARES=1024

# --- LLMInt: KI-Oberflaeche unter /ki/ (optional) -----------------------------
# LLMInt (eigener Compose-Stack) laeuft hinter dem auth-Container im selben
# Origin wie das Intranet (gleiches HTTPS-Zertifikat, Windows-Anmeldung ueber
# /ki/sso.php). Einrichtung beider Seiten: docs/llmint.md.
LLMINT_ENABLED=false
# Ziel ohne Pfad: gemeinsames Docker-Netz auf demselben Host
# (COMPOSE_FILE=docker-compose.yml:docker-compose.llmint.yml) -> http://llmint-web,
# anderer Host -> http://<IP>:<Port>.
LLMINT_UPSTREAM=
# Oeffentlicher Pfad (Standard /ki; ohne abschliessenden Schraegstrich).
# LLMINT_PATH=/ki
# Name des externen Docker-Netzes (docker network create --subnet 172.30.251.0/24 llmint-proxy).
# LLMINT_PROXY_NETWORK=llmint-proxy

# --- Weiterleitung externer Navigationskacheln ueber den Reverse-Proxy -------
# Welche Kacheln ueber den auth-Container laufen und welche Quellnetze das Ziel
# direkt aufrufen, steht ausschliesslich im Adminbereich (Navigation ->
# "Ziel ueber den Reverse-Proxy dieser Anwendung aufrufen", docs/weiterleitung.md).
# Hier nur Betriebsparameter des Containers, alle mit Arbeitsstandard:
# Pruefung des Zielzertifikats: require (System-CAs) oder none (eigenes Zertifikat).
# NAV_PROXY_SSL_VERIFY=require
# Abstand des Abgleichs der Ziele in Sekunden.
# NAV_PROXY_INTERVAL=60
# Adresse des internen Endpunkts und Ablageort der erzeugten Apache-Konfiguration.
# NAV_PROXY_URL=http://app/internal/nav-proxy-config
# NAV_PROXY_FILE=/etc/apache2/intranet/weiterleitung.conf

# --- Statistik ---------------------------------------------------------------
CLICK_RETENTION_DAYS=400

# --- SMS-Gateway / Alarmierung ----------------------------------------------
# Optional. Host und Benutzername koennen auch im Adminbereich gepflegt werden.
# Das Passwort wird NICHT angezeigt oder exportiert. Empfohlen ist, es nur
# hier (oder als Docker-Secret) zu hinterlegen und nicht in der Datenbank.
ALARM_HOST=
ALARM_USERNAME=
# Alternativ als Docker-Secret: ALARM_PASSWORD_FILE=/run/secrets/alarm_password
ALARM_PASSWORD=

# --- SNMP-Ueberwachung ------------------------------------------------------
# Community-String, Standort und Kontakt koennen auch im Adminbereich
# gepflegt werden (Tabelle `settings` ueberschreibt diese Umgebungswerte).
# Community-String fuer den Produktivbetrieb zwingend aendern!
SNMP_COMMUNITY=public
# sysLocation/sysContact, die der Agent ausliefert
SNMP_SYS_LOCATION=Intranet
SNMP_SYS_CONTACT=admin@example.internal
# Host-Port des SNMP-Agenten (UDP); Container lauscht intern immer auf 161/udp.
# Nur ueber die Umgebung aenderbar (Docker-Port-Mapping).
SNMP_PORT=161
