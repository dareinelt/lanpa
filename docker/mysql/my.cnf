# MySQL der Anwendung (Container db). Siehe docs/installation.md, Abschnitt
# "Dimensionierung", und docs/storage-stack.md, Abschnitt 6.5, fuer die
# entsprechende Konfiguration des storage-sync-Katalogs.
# Die Pufferpoolgroesse setzt docker-compose.yml (DB_BUFFER_POOL).
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
skip-name-resolve

# Je Request eine eigene Verbindung, kein Pooling (app/Core/Database.php).
# Bei mod_php/prefork begrenzt MaxRequestWorkers in docker/php/apache-prefork.conf
# die gleichzeitigen Requests; dieser Wert muss darueber liegen und zusaetzlich
# die Nebenverbraucher abdecken (mail, mail-archive, sync, snmp, office-backup,
# phpmyadmin, Healthchecks, Root-Reserve).
max_connections = 240
thread_cache_size = 64

# InnoDB. O_DIRECT vermeidet doppeltes Puffern im Seitencache des Hosts.
innodb_flush_method = O_DIRECT

# Schreibspitzen (AD-Synchronisation, Laufwerksmeldungen der Clients) sollen
# nicht in Checkpoints laufen. Anders als beim storage-sync-Katalog bleibt
# innodb_flush_log_at_trx_commit = 1 (Standard): diese Daten sind nicht
# rekonstruierbar, ein Absturz darf keine bestaetigte Transaktion verlieren.
innodb_redo_log_capacity = 1G
innodb_log_buffer_size = 64M
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000

# Kuerzer als beim Katalog (60): hier haengt ein Nutzer am Request.
innodb_lock_wait_timeout = 30

# Jeder Deadlock landet im Container-Log. Kostet im Normalbetrieb nichts und
# ist Voraussetzung fuer die Fehlersuche bei Synchronisation und
# Laufwerksmeldungen.
innodb_print_all_deadlocks = ON

# Viele Verbindungen kurzer Lebensdauer (eine je Request).
table_open_cache = 2000

[client]
default-character-set = utf8mb4
