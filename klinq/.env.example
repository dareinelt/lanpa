# --- Anwendung ---
APP_ENV=production
APP_DEBUG=false
APP_NAME=KLINQ
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Europe/Berlin
# Schlüssel für Zugangsdaten, die in der Anwendung gespeichert werden (z. B. das Passwort des Help-Desk-Postfachs).
# Einmalig setzen, z. B. mit: openssl rand -base64 32
# Leer = Ableitung aus DB_PASSWORD/APP_URL; wird der Schlüssel später geändert, müssen gespeicherte Passwörter neu erfasst werden.
APP_KEY=
# Firmenname auf Etiketten/Login
APP_COMPANY_NAME=Musterfirma GmbH

# --- Datenbank ---
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=assets
DB_USERNAME=assets
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
# Nur für Entwicklung: Host-Port für MySQL
DB_FORWARD_PORT=3307

# --- Session/Sicherheit ---
# Leer lassen = HTTPS automatisch erkennen. true erzwingt Secure-Cookies.
SESSION_SECURE=
SESSION_LIFETIME=480
SESSION_SAME_SITE=Lax

# --- Erster Administrator (wird nur angelegt, wenn noch kein Benutzer existiert) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# --- PDF-Dienst (Container pdf, HTML->PDF fuer Uebergabeprotokolle); leer = deaktiviert ---
PDF_SERVICE_URL=http://pdf:8000
PDF_SERVICE_TIMEOUT=30

# --- E-Mail-Dienst (Container mail; sendet Entnahme-/Retourennachweise und Übergabeprotokolle
# als PDF-Anhang, wenn Mitarbeiter dies im Workflow per Checkbox anfordern); leer = deaktiviert ---
MAIL_SERVICE_URL=http://mail:8025
MAIL_SERVICE_TIMEOUT=15
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=${APP_NAME}
# --- SMTP-Zugangsdaten des mail-Containers (Anbindung an den echten Mailserver) ---
SMTP_HOST=
SMTP_PORT=587
# Verschlüsselung: none, starttls (empfohlen, i. d. R. Port 587) oder ssl (i. d. R. Port 465)
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10

# --- Uploads ---
MAX_UPLOAD_BYTES=20971520
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,webp,heic,txt,csv,xlsx,docx

# --- Active Directory / LDAP ---
AD_ENABLED=false
# Treiber: ldap (produktiv) oder fake (Entwicklung/Tests, liest AD_FAKE_FILE)
AD_DRIVER=ldap
AD_FAKE_FILE=database/fixtures/fake-ad-users.json
# Zeitgesteuerte Synchronisation im App-Container: Intervall in Minuten (0 = aus, alternativ Cron auf dem Host: php bin/sync-ad.php)
AD_SYNC_INTERVAL_MINUTES=0
AD_HOST=dc01.example.local
AD_PORT=636
AD_BASE_DN=OU=Users,DC=example,DC=local
AD_BIND_DN=CN=svc-assets,OU=Service,DC=example,DC=local
AD_BIND_PASSWORD=
AD_USER_FILTER=(&(objectClass=user)(objectCategory=person)(!(objectClass=computer)))
# Attribut-Mapping (LDAP-Attribut je Feld)
AD_ATTR_GUID=objectGUID
AD_ATTR_USERNAME=sAMAccountName
AD_ATTR_FIRST_NAME=givenName
AD_ATTR_LAST_NAME=sn
AD_ATTR_DISPLAY_NAME=displayName
AD_ATTR_EMAIL=mail
AD_ATTR_PERSONNEL_NUMBER=employeeID
AD_ATTR_DEPARTMENT=department
AD_ATTR_POSITION=title
AD_ATTR_PHONE=telephoneNumber
AD_ATTR_LOCATION=physicalDeliveryOfficeName
AD_ATTR_COST_CENTER=extensionAttribute1
AD_ATTR_ACCOUNT_CONTROL=userAccountControl
# LDAP-Authentifizierung für Anmeldung (optional)
AD_AUTH_ENABLED=false
AD_AUTH_DEFAULT_ROLE=portal

# --- Anbindung an das Intranet (LANPA) ---
# KLINQ laeuft als Bestandteil des Intranets hinter dessen auth-Container. Die
# Windows-Anmeldung (Kerberos/NTLM) und die Sitzung uebernimmt das Intranet; es
# stellt einen kurzlebigen, signierten Einstiegsschein aus (Einstieg ueber
# /klinq-starten der Intranet-Anwendung, Pruefung in KLINQ unter /sso/lanpa).
# Rollen und Berechtigungsgruppen (Help-Desk-Agent, Asset-Management,
# Statistiken) werden im Adminbereich des Intranets ueber AD-Gruppen vergeben.
LANPA_ENABLED=true
# Gemeinsames Geheimnis mit dem Intranet, mindestens 32 Zeichen
# (im Intranet: KLINQ_SSO_SECRET). Leer = Anbindung abgeschaltet.
KLINQ_SSO_SECRET=
LANPA_SSO_ISSUER=lanpa
LANPA_SSO_AUDIENCE=klinq
# Basisadresse des Intranets (Rueckweg, absolute Verweise)
LANPA_BASE_URL=http://localhost:8080
# Interne Adresse des Intranet-Containers fuer Aufrufe ohne Proxy
# (KI-Endpunkt: /internal/klinq/ki, Melderdaten: /internal/klinq/melder)
LANPA_INTERNAL_URL=http://app
# Stylesheet mit den Designfarben des Intranets; leer = /klinq-design.css am
# selben Host (protokollrelativ)
LANPA_DESIGN_CSS=
# Zugang fuer die internen Schnittstellen des Intranets (im Intranet:
# KLINQ_SERVICE_TOKEN, Ablage in /run/intranet-sso/token)
KLINQ_SERVICE_TOKEN=
# Ablage bereits verwendeter Einstiegsscheine (Einmalverwendung)
LANPA_SSO_REPLAY_STORE=storage/tmp/lanpa-sso-used.json
# Unterpfad, unter dem KLINQ im Intranet erscheint (der Proxy entfernt ihn,
# der Container ergaenzt ihn in den Antworten). Leer = Betrieb unter "/".
KLINQ_BASE_PATH=/klinq

# --- Help Desk / Ticketsystem ---
# Modul aktivieren (false blendet Navigation, Dashboard-Kacheln, globale Suche und Scheduler-Job aus)
HELPDESK_ENABLED=true
# Präfix der Ticketnummer: PREFIX-JJJJ-NNNNNN
HELPDESK_TICKET_PREFIX=HD
# Standardschwellen in Prozent der SLA-Zeit (gelten, wenn eine SLA-Regel keine eigenen Werte hat)
HELPDESK_SLA_WARNING_PERCENT=75
HELPDESK_ESCALATION_PERCENT=90
# Eskalation + SLA-Prüfung + Auto-Close im App-Container: Intervall in Minuten (0 = aus, alternativ Cron auf dem Host: php bin/helpdesk.php process)
HELPDESK_ESCALATION_ENABLED=true
HELPDESK_ESCALATION_INTERVAL_MINUTES=5
# Gelöste Tickets nach n Tagen ohne Rückmeldung automatisch schließen (0 = aus)
HELPDESK_AUTO_CLOSE_DAYS=7
# Melder dürfen gelöste/geschlossene Tickets innerhalb dieser Frist selbst wieder öffnen (0 = nie)
HELPDESK_REOPEN_DAYS=14
# E-Mail-Benachrichtigungen (nutzen den mail-Container); optionales Sammelpostfach für neue Tickets
HELPDESK_NOTIFICATION_ENABLED=true
HELPDESK_NOTIFICATION_INBOX=
# Domain für Message-IDs ausgehender Ticket-Mails (Threading); leer = aus MAIL_FROM_ADDRESS bzw. APP_URL ableiten
HELPDESK_MAIL_DOMAIN=
# --- Ausgehende Help-Desk-E-Mails (Versandkonto) ---
# Achtung: Die folgenden Werte sind nur Startwerte. Das Versandkonto inklusive Server wird in der Anwendung
# konfiguriert (Auswertung & System → Administration → E-Mail-Versand). Ist dort kein Konto aktiv, versendet
# der Help Desk weiterhin über den Mail-Container (MAIL_SERVICE_URL).
HELPDESK_SMTP_ENABLED=false
HELPDESK_SMTP_HOST=
HELPDESK_SMTP_PORT=587
# ssl (Port 465), starttls (Port 587) oder none (nur internes Relay ohne Anmeldung)
HELPDESK_SMTP_ENCRYPTION=starttls
HELPDESK_SMTP_USERNAME=
HELPDESK_SMTP_PASSWORD=
HELPDESK_SMTP_FROM_ADDRESS=
HELPDESK_SMTP_FROM_NAME=
# Antwortadresse (Reply-To); leer = Antworten gehen an die Absenderadresse
HELPDESK_SMTP_REPLY_TO=
HELPDESK_SMTP_TIMEOUT=15
HELPDESK_SMTP_VERIFY_PEER=true
# --- E-Mail-Eingang (IMAP → Ticket/Kommentar) ---
# Achtung: Die folgenden Werte sind nur Startwerte. Das Postfach wird in der Anwendung konfiguriert
# (Auswertung & System → Administration → E-Mail-Postfach); ab dem ersten Speichern gilt ausschließlich diese Konfiguration.
# Postfach abholen und Nachrichten als Ticket (neu) oder Kommentar (Antwort per Ticketnummer/In-Reply-To) verarbeiten
HELPDESK_MAIL_ENABLED=false
# imap (Postfach per IMAP) oder file (.eml-Dateien aus HELPDESK_MAIL_FILE_PATH, für Entwicklung/Tests)
HELPDESK_MAIL_DRIVER=imap
HELPDESK_MAIL_FILE_PATH=storage/mail-inbox
HELPDESK_IMAP_HOST=
HELPDESK_IMAP_PORT=993
# ssl (993), starttls (143) oder none
HELPDESK_IMAP_ENCRYPTION=ssl
HELPDESK_IMAP_USERNAME=
HELPDESK_IMAP_PASSWORD=
HELPDESK_IMAP_MAILBOX=INBOX
# Verarbeitete Mails in diesen Ordner verschieben (leer = nur als gelesen markieren)
HELPDESK_IMAP_PROCESSED_MAILBOX=
HELPDESK_IMAP_TIMEOUT=15
HELPDESK_IMAP_VERIFY_PEER=true
# Abholintervall in Minuten (0 = nur manuell); der Container prüft minütlich, ob laut Konfiguration ein Lauf fällig ist
HELPDESK_MAIL_INTERVAL_MINUTES=2
HELPDESK_MAIL_BATCH_SIZE=50
# Benutzerkonto, unter dem Tickets aus E-Mails angelegt werden (benötigt helpdesk.create); unbekannte Absender zulassen; Standard-Tickettyp
HELPDESK_MAIL_SYSTEM_USER=admin
HELPDESK_MAIL_ALLOW_UNKNOWN_SENDERS=true
HELPDESK_MAIL_DEFAULT_TYPE=incident
# --- Störungsmeldeformular für Anwender (/stoerung, ohne Anmeldung) ---
# Formular mit nur zwei Feldern (Betreff, Beschreibung); Benutzer, Rechnername/IP und AD-Daten werden automatisch erfasst
HELPDESK_QUICK_REPORT_ENABLED=true
# Benutzerkonto, unter dem die Meldungen angelegt werden (benötigt helpdesk.create); leer = HELPDESK_MAIL_SYSTEM_USER
# Fehlt das Konto, legt bin/migrate.php es ohne Passwort mit der Rolle helpdesk_agent an (Anmeldung damit nicht möglich).
HELPDESK_QUICK_REPORT_SYSTEM_USER=admin
HELPDESK_QUICK_REPORT_TYPE=incident
# Benutzername aus dem Header X-Remote-User übernehmen. Im Intranet setzt der auth-Container
# diesen Header nach erfolgreicher Windows-Anmeldung (NTLM/Kerberos); im Betrieb ohne Intranet
# nur aktivieren, wenn ein vertrauenswürdiger Reverse-Proxy den Header liefert (sonst fälschbar!)
HELPDESK_QUICK_REPORT_TRUST_USER_HEADER=false
HELPDESK_QUICK_REPORT_USER_HEADER=X-Remote-User
# Rechnername per Reverse-DNS aus der IP ermitteln (sonst wird nur die IP-Adresse erfasst)
HELPDESK_QUICK_REPORT_RESOLVE_HOSTNAME=true
# Zugriff auf diese Netze beschränken (CIDR oder einzelne IPs, kommagetrennt), z. B. 10.0.0.0/8,192.168.0.0/16; leer = keine Einschränkung
HELPDESK_QUICK_REPORT_NETWORKS=
# Meldungen je Browsersitzung und Stunde (0 = unbegrenzt)
HELPDESK_QUICK_REPORT_RATE_LIMIT=10
# Startwerte für den Katalog der Sammelkonten (AD-/SSO-Anmeldenamen, kommagetrennt), bei denen
# die Angabe eines zusätzlichen Benutzers Pflicht ist. Gepflegt wird der Katalog unter
# Help-Desk-Einstellungen > Störungsformular (Datenbank hat Vorrang vor diesen Startwerten).
HELPDESK_QUICK_REPORT_SHARED_ACCOUNTS=
# Startwert für den Erklärungstext über dem Pflichtfeld; leer = eingebauter Standardtext
HELPDESK_QUICK_REPORT_SHARED_ACCOUNTS_HINT=

# --- Vorlageneinstellungen (Helpdesk) ---------------------------------------
# Praefix-Text, der beim Senden einer Agenten-Mail aus einem Ticket serverseitig
# vor den Text des Agenten gesetzt wird (er erscheint nicht im Mail-Dialog).
# Gepflegt wird der Text unter Help-Desk-Einstellungen > Vorlageneinstellungen
# (Datenbank hat Vorrang vor diesem Startwert); leer = kein Praefix.
# Absaetze werden durch Leerzeilen getrennt, einfache Zeilenumbrueche bleiben erhalten.
HELPDESK_REPLY_TEMPLATE_PREFIX=

# Eingangsbestaetigung fuer Meldungen aus dem Stoerungsformular (/stoerung) und dem
# Stoerungspostfach; beim Anlegen durch einen Agenten optional im Assistenten.
# Platzhalter: {anrede} {name} {ticketnummer} {betreff} {datum} {link} {firma}
# Gepflegt wird der Text unter Help-Desk-Einstellungen > Vorlageneinstellungen; leer = kein Versand.
HELPDESK_REPLY_TEMPLATE_CONFIRMATION=

# Hinweis am Fuss jeder Benachrichtigungsmail des Help Desk (auch der Eingangsbestaetigung,
# nicht der von Agenten verfassten E-Mail). Platzhalter: {firma}
# Gepflegt unter Help-Desk-Einstellungen > Vorlageneinstellungen; leer = eingebauter Standardtext,
# zum Abschalten wird das Feld in der Oberflaeche geleert.
HELPDESK_REPLY_TEMPLATE_FOOTER=

# --- KI-Unterstuetzung (Helpdesk) -------------------------------------------
# Aktiviert das App-Kontextmenue und "Mit KI verbessern" in den Ticket-Textfeldern.
# Endpunkt, Modell und API-Schluessel werden bevorzugt unter "Auswertung & System"
# > "KI-Unterstuetzung (Help Desk)" gepflegt (Schluessel verschluesselt in der DB).
# Die Werte hier sind nur Vorgaben/Rueckfall.
HELPDESK_AI_ENABLED=false
HELPDESK_AI_NAME=
# Adresse inklusive /v1; lokaler Test-Container: http://ai:11434/v1
HELPDESK_AI_URL=
HELPDESK_AI_MODEL=
HELPDESK_AI_TIMEOUT=60
HELPDESK_AI_API_KEY=

# --- Lokaler KI-Test-Container (docker compose --profile ai up -d) -----------
# Ollama-Port auf dem Host (Admin-UI von aussen: http://localhost:<AI_PORT>/v1)
AI_PORT=11434
# Kleines Modell, das beim Start automatisch geladen wird
AI_MODEL=qwen3.5:0.8b
# Wie lange das Modell nach dem letzten Aufruf im Speicher bleibt (z. B. 10m, 1h, -1 = dauerhaft)
AI_KEEP_ALIVE=10m
